{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/notifications/sync-expiry",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/prices/sync",
      "schedule": "0 2 * * *"
    }
  ]
}
