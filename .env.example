# SmartFridge v3 environment variables
# Copy the needed values into .env.local for local dev and into Vercel
# Project Settings > Environment Variables for production.

# Public frontend Supabase config
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"

# Server-side Supabase config used by Vercel Serverless Functions
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"

# Gemini AI
GEMINI_API_KEY="replace-with-your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Public app URL used in password reset and Gmail login links
APP_URL="https://your-vercel-domain.vercel.app"

# Optional SMTP sender settings kept only for custom email fallback.
# Password reset and Gmail email-code login currently use Supabase Auth emails.
MAIL_SERVER="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USE_TLS="true"
MAIL_USE_SSL="false"
MAIL_USERNAME="replace-with-sender-email@gmail.com"
MAIL_PASSWORD="replace-with-gmail-app-password"
MAIL_DEFAULT_SENDER="replace-with-sender-email@gmail.com"

# Auth settings
# Supabase Gmail OTP emails must include {{ .Token }} in the Magic Link template.
GOOGLE_LOGIN_EMAIL_DOMAIN="gmail.com"

# Optional: when set, Vercel Cron calls must send Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-a-long-random-secret"
